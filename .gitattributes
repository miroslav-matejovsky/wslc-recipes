# Normalise line endings in the repo
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Shell scripts and env files must stay LF (mounted into Linux containers)
*.sh   text eol=lf
.env*  text eol=lf

*.md   text diff=markdown
*.json text
*.yml  text
*.yaml text

# Binary
*.png  binary
*.jpg  binary
*.bak  binary
